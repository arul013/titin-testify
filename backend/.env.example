# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# App Configuration
APP_NAME=Learning Nexus CBT
APP_ENV=development
APP_DEBUG=true

# CORS
FRONTEND_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Media storage — SEMUA media (gambar/audio/video) di Cloudflare R2.
#   STORAGE_BACKEND=r2  → paksa R2 (disarankan: gagal jelas bila R2 salah konfigurasi,
#                         tak diam-diam pindah ke Supabase).
#   (auto = R2 bila terisi lalu fallback Supabase; supabase = paksa Supabase — TIDAK dipakai di sini.)
STORAGE_BACKEND=r2
STORAGE_BUCKET=media          # hanya relevan bila backend supabase (fallback)
# Cloudflare R2:
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# URL publik = CUSTOM DOMAIN yang dipasang ke bucket R2 (cert TLS otomatis dari Cloudflare).
# mis. https://media.namadomainmu.com  (JANGAN pakai r2.dev bila cert bermasalah).
CLOUDFLARE_R2_PUBLIC_URL=https://media.namadomainmu.com

# Background jobs (F4) — secret untuk endpoint internal /api/internal/jobs/*.
# Kosong = endpoint dinonaktifkan (dev boleh kosong). Prod: isi string acak panjang,
# penjadwal cron kirim di header X-Internal-Secret. Buat nilai: `openssl rand -hex 32`
INTERNAL_JOB_SECRET=
