# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# App Configuration
APP_NAME=Learning Nexus CBT
APP_ENV=development
APP_DEBUG=true

# CORS
FRONTEND_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Background jobs (F4) — secret untuk endpoint internal /api/internal/jobs/*.
# Kosong = endpoint dinonaktifkan (dev boleh kosong). Prod: isi string acak panjang,
# penjadwal cron kirim di header X-Internal-Secret. Buat nilai: `openssl rand -hex 32`
INTERNAL_JOB_SECRET=
